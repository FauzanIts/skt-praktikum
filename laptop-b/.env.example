# Salin berkas ini menjadi .env, lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env TIDAK diunggah ke GitHub (berisi alamat jaringan kelompok masing-masing).

# Jalur penyimpanan SQLite di dalam container.
# Disimpan di named volume "data-cloud", jadi tidak hilang saat container dibuat ulang.
# Untuk mengosongkan data lama (C.6): docker compose down -v
DB_PATH=/data/cloud.db

# 0 = setiap kiriman selalu disimpan (data ganda MUNCUL)
# 1 = request_id diperiksa lebih dulu (data ganda TIDAK muncul)
# Percobaan C.6 membandingkan kedua nilai ini.
IDEMPOTEN=0

# Persentase balasan yang sengaja diperlambat, meniru server sibuk.
# Perlambatan terjadi SETELAH data tersimpan, jadi client bisa timeout
# padahal data sudah masuk -> inilah yang memicu kirim ulang.
LAMBAT_PERSEN=30

# Lama perlambatan satu balasan, dalam milidetik.
LAMBAT_MS=1500

# Identitas node ini.
NODE_ID=laptop-b
