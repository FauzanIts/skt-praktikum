# Salin berkas ini menjadi .env, lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env TIDAK diunggah ke GitHub (berisi alamat jaringan kelompok masing-masing).

# Jalur penyimpanan SQLite di dalam container.
# Disimpan di named volume "data-cloud", jadi tidak hilang saat container dibuat ulang.
# Untuk mengosongkan data lama (C.6): docker compose down -v
DB_PATH=/data/cloud.db

# 0 = setiap kiriman selalu disimpan (data ganda MUNCUL)
# 1 = request_id diperiksa lebih dulu (data ganda TIDAK muncul)
# Percobaan C.6 membandingkan kedua nilai ini.
IDEMPOTEN=0

# Persentase balasan yang sengaja diperlambat, meniru server sibuk.
# Perlambatan terjadi SETELAH data tersimpan, jadi client bisa timeout
# padahal data sudah masuk -> inilah yang memicu kirim ulang.
LAMBAT_PERSEN=30

# Lama perlambatan satu balasan, dalam milidetik.
LAMBAT_MS=1500

# Identitas node ini.
NODE_ID=laptop-b

# Port server gRPC (Pekan 5). Harus sama dengan PORT_GRPC di Laptop A
# dan dengan pemetaan port di docker-compose.yml.
PORT_GRPC=50051

# ---------------------------------------------------------------------------
# PERSYARATAN PEKAN 6 (C.11 MQTT dan C.13 GraphQL)
#
# .env TIDAK diunggah ke GitHub, jadi dua nilai ini harus disetel SENDIRI di
# tiap laptop sebelum mengerjakan C.11:
#
#   IDEMPOTEN=1
#     QoS 1 berarti "at-least-once": broker boleh mengantar pesan yang sama
#     lebih dari sekali. Dengan IDEMPOTEN=0, tiap antar-ulang itu menjadi
#     BARIS BARU, sehingga rentang seq yang Anda ukur tampak membengkak dan
#     hasilnya tidak bisa dibandingkan dengan QoS 0.
#
#   LAMBAT_PERSEN=0
#     Perlambatan buatan diletakkan di dalam penyimpanan.simpan(), dan fungsi
#     itu juga dipanggil oleh subscriber MQTT pada network loop thread paho.
#     time.sleep() di titik itu MEMBEKUKAN loop, sehingga PUBACK QoS 1
#     tertunda dan pesan masuk menumpuk. Hasil pengukuran C.11 jadi kacau
#     bukan karena MQTT-nya salah, tetapi karena simulasi server sibuk.
#
# Nama broker tidak perlu ditulis di sini: docker-compose.yml sudah
# menetapkan MQTT_HOST=mosquitto untuk service cloud-api, dan kode
# mqtt_subscriber.py memakai "mosquitto" sebagai nilai default.
# ---------------------------------------------------------------------------

