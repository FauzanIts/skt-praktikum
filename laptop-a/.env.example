# Salin berkas ini menjadi .env, lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
#
# .env TIDAK diunggah ke GitHub (berisi alamat jaringan kelompok masing-masing).
# Nilai di bawah adalah contoh dari Modul 2; ganti CLOUD_HOST dengan IPv4 Laptop B
# setelah hotspot dinyalakan dan diverifikasi lewat ipconfig.

# IPv4 Laptop B (penyedia hotspot). Bawaannya 192.168.137.1 pada Windows.
CLOUD_HOST=192.168.137.1

# Identitas node ini di seluruh sistem.
NODE_ID=laptop-a

# Jalur pengiriman: rest (Pekan 4) | grpc (Pekan 5) | mqtt (Pekan 6)
MODE=rest

# Batas tunggu satu percobaan kirim ke cloud-api, dalam detik.
TIMEOUT_S=1

# Jumlah maksimum percobaan kirim ulang sebelum menyerah.
MAKS_COBA=3
